generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // or "mysql" or "sqlite" //
  url      = env("DATABASE_URL")
}

// ======== USER MODELS ========

model User {
  id           String             @id @default(uuid())
  name     String  @db.VarChar(50)
  email    String  @unique
  password String?

  // Authentication related
  emailVerified           Boolean      @default(false)
  verificationCode        String?
  verificationCodeExpires DateTime?
  resetCode               String?
  resetCodeVerified       Boolean?     @default(false)
  resetCodeExpires        DateTime?
  googleId                String?      @unique
  linkedinId              String?      @unique
  signup_method           SignupMethod @default(MANUAL)

  // Profile information
  phone           String?         @db.VarChar(20)
  gender          Gender          @default(MALE)
  country         String          @default("Egypt") @db.VarChar(100)
  specialization  String          @default("Other") @db.VarChar(100)
  experienceLevel ExperienceLevel @default(BEGINNER)
  bio             String?         @db.Text

  // Role and Mentor status
  isMentor Boolean @default(false)
  role     Role    @default(MENTEE)

  // Media and statistics
  image_url     String? @default("http://localhost:3000/uploads/image_url.jpg")
  cover_url     String?
  video_url     String?
  totalSessions Int     @default(0)
  totalMinutes  Int     @default(0)

  // Social media links
  linkedin  String?
  behance   String?
  github    String?
  instagram String?
  dribbble  String?

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations to other models
  chats             ChatParticipants[]
  messages          Message[]
  mentorSessions    Session[]         @relation("mentorSessions")
  menteeSessions    Session[]         @relation("menteeSessions")
  experiences       Experience[]
  certificates      Certificate[]
  education         Education[]
  ratings           Rating[]           @relation("RatedUser")
  givenRatings      Rating[]           @relation("RaterUser")
  achievements      Achievement[]

  // Mentor-specific relations
  mentorRequests     MentorRequest[] // Relation to mentor requests
  mentorServices     MentorService[]
  mentorAvailability MentorAvailability[]
  Notification       Notification[]

  @@index([email])
  @@index([googleId])
  @@index([linkedinId])
  @@index([isMentor]) // Index for querying mentors
}

enum Gender {
  MALE
  FEMALE
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  EXPERT
}

enum SignupMethod {
  MANUAL
  GOOGLE
  LINKEDIN
}

enum Role {
  MENTOR
  MENTEE
  ADMIN
}

// ======== MENTOR MODELS ========

model MentorService {
  id          Int                  @id @default(autoincrement())
  mentorId    String
  name        String               @db.VarChar(100)
  description String               @db.Text
  duration    Int // Duration in minutes
  questions   Question[] // Questions for the session
  dates       MentorAvailability[]
  isActive    Boolean              @default(true)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  mentor   User      @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  sessions Session[] // Sessions booked for this service

  @@index([mentorId])
  @@index([isActive])
}

model Question {
  id        Int           @id @default(autoincrement())
  serviceId Int
  service   MentorService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  question  String
  required  Boolean       @default(false)

  @@index([serviceId])
}

model MentorAvailability {
  id                Int                      @id @default(autoincrement())
  title             String
  mentorId          String
  availableFrom     DateTime                @default(now())
  expireAt          DateTime?               // The expiration time
  maxDaysBefore     Int                     // Maximum number of days user can book before
  minHoursBefore    Int                     // Minimum number of hours user can book before
  maxBookingsPerDay Int                     // Maximum number of bookings per day
  breakMinutes      Int?                    // Number of break minutes between sessions
  isRecurring       Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  mentor            User                    @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  MentorService     MentorService?          @relation(fields: [mentorServiceId], references: [id])
  mentorServiceId   Int?
  days              MentorAvailabilityDay[] // Relation to days

  @@index([mentorId])
  @@index([isRecurring])
}

model MentorAvailabilityDay {
  id                Int                      @id @default(autoincrement())
  mentorAvailabilityId Int
  dayOfWeek         DayOfWeek?              // For recurring availability (e.g., Saturday)
  specificDate      DateTime?               // For non-recurring availability
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  mentorAvailability MentorAvailability     @relation(fields: [mentorAvailabilityId], references: [id], onDelete: Cascade)
  intervals         MentorAvailabilityInterval[] // Relation to intervals

  @@index([mentorAvailabilityId])
  @@index([dayOfWeek])
  @@index([specificDate])
}

model MentorAvailabilityInterval {
  id                Int                      @id @default(autoincrement())
  mentorAvailabilityDayId Int
  startTime         String                  // Time string, e.g., '11:45'
  endTime           String                  // Time string, e.g., '14:00'
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  mentorAvailabilityDay MentorAvailabilityDay @relation(fields: [mentorAvailabilityDayId], references: [id], onDelete: Cascade)

  @@index([mentorAvailabilityDayId])
}

model MentorRequest {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  specialization  String
  experienceLevel String
  TargetMentees   String
  linkedin        String
  bio             String
  status          ReqStat   @default(PENDING)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reviewedBy      String? // ID of admin who reviewed
  reviewedAt      DateTime? // When the request was reviewed
}

enum ReqStat {
  PENDING
  APPROVED
  REJECTED
}

enum DayOfWeek {
  SATURDAY
  SUNDAY
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
}

enum BookingStatus {
  AVAILABLE
  BOOKED
  BLOCKED
}

// ======== USER PROFILE EXTENSIONS ========

model Experience {
  id         Int       @id @default(autoincrement())
  userId     String
  title      String    @db.VarChar(100)
  company    String    @db.VarChar(100)
  from       DateTime
  to         DateTime?
  stillThere Boolean   @default(false)
  summary    String    @db.Text
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Certificate {
  id        Int       @id @default(autoincrement())
  userId    String
  name      String    @db.VarChar(100)
  donor     String    @db.VarChar(100)
  date      DateTime
  expireAt  DateTime?
  number    String?   @db.VarChar(100)
  link      String?   @db.VarChar(255)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Education {
  id        Int       @id @default(autoincrement())
  userId    String
  school    String    @db.VarChar(100)
  degree    String    @db.VarChar(100)
  from      DateTime
  to        DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Rating {
  id        Int      @id @default(autoincrement())
  userId    String // User being rated
  raterId   String // User giving the rating
  stars     Float // @db.DoublePrecision
  comment   String   @db.Text
  likes     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User @relation("RatedUser", fields: [userId], references: [id], onDelete: Cascade)
  rater User @relation("RaterUser", fields: [raterId], references: [id], onDelete: Cascade)

  @@unique([userId, raterId]) // One rating per user pair
  @@index([userId])
  @@index([raterId])
}

model Achievement {
  id        Int      @id @default(autoincrement())
  userId    String
  name      String   @db.VarChar(100)
  image     String   @db.VarChar(255)
  date      DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ======== MESSAGING MODELS ========

model Chat {
  id           String             @id @default(uuid())
  type         ChatType           @default(DIRECT)
  participants ChatParticipants[]
  messages     Message[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([type])
}

model ChatParticipants {
  id       String    @id @default(uuid())
  userId   String
  chatId   String
  joinedAt DateTime  @default(now())
  lastRead DateTime? // Track when user last read messages

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)

  @@unique([userId, chatId])
  @@index([chatId])
  @@index([userId])
}

model Message {
  id        String      @id @default(uuid())
  chatId    String
  senderId  String
  content   String      @db.Text
  type      MessageType @default(TEXT)
  read      Boolean     @default(false)
  createdAt DateTime    @default(now())

  chat   Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  sender User @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([chatId])
  @@index([senderId])
  @@index([createdAt])
}

enum ChatType {
  DIRECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
}

// ======== SESSION MODELS ========

model Session {
  id            String        @id @default(uuid())
  menteeId      String
  mentorId      String
  serviceId     Int?          // Optional link to the specific mentor service
  status        SessionStatus @default(PENDING)
  googleMeetUrl String?
  scheduledAt   DateTime
  duration      Int           @default(60) // Session duration in minutes
  notes         String?       @db.Text
  feedback      String?       @db.Text
  answers       Answer[]
  menteeQ       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  mentee        User              @relation(name: "menteeSessions", fields: [menteeId], references: [id], onDelete: Cascade)
  mentor        User              @relation(name: "mentorSessions", fields: [mentorId], references: [id], onDelete: Cascade)
  service       MentorService?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([menteeId])
  @@index([mentorId])
  @@index([serviceId])
  @@index([status])
  @@index([scheduledAt])
}

model Answer {
  id            Int       @id @default(autoincrement())
  questionId    Int
  text          String

  sessionId     String
  session       Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum SessionStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
  CANCELLED
}

// ======== Notifications =========

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  from      Int? // ID of the user made the action that triggered the Notification
  title     String // Title of the Notification
  body      String // Notification body
  sent      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
